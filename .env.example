# Copy to .env and fill in. Never commit .env.

# OpenRouter: one key for every model. Give the key a credit limit as the spend guard.
OPENROUTER_API_KEY=

# Langfuse Cloud Hobby: traces and datasets.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# E2B Hobby: sandboxes for oracle checks.
E2B_API_KEY=
